# BreakThru Assessments - Environment Configuration
# Copy this file to .env for local development

# Security
SECRET_KEY=breakthru-secret-dev-replace-in-production-use-strong-entropy
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,assessments.breakthru.pk

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=sqlite:///db.sqlite3
# In production, use:
# DATABASE_URL=postgresql://breakthru_user:strong_password@localhost:5432/breakthru_assessments

# Company & Application Branding
COMPANY_NAME=BreakThru
COMPANY_TAGLINE=Learn. Prove It. BreakThru.
COMPANY_DOMAIN=breakthru.pk
PORTAL_URL=https://assessments.breakthru.pk
TIME_ZONE=Asia/Karachi

# Security & Session Settings
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Email Settings (Optional / Configurable)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@breakthru.pk
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BreakThru Assessments <no-reply@breakthru.pk>
